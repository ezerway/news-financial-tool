# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG TRENDPULSE
# ==========================================

# Port chạy dịch vụ Web Dashboard (Mặc định: 3000)
PORT=3000
NODE_ENV=production

# Google Gemini API Key (Có thể cấu hình trực tiếp trên Web Dashboard)
GEMINI_API_KEY=your_gemini_api_key_here

# Vùng địa lý mặc định cho Google Trends (VN, US, SG, GB)
DEFAULT_GEO=VN

# Tài khoản quản trị Web Dashboard khi triển khai VPS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
AUTH_SECRET=your_random_secret_key_at_least_32_characters_long

# Cấu hình thông báo Telegram Bot (Tùy chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cấu hình thông báo Slack Incoming Webhook (Tùy chọn)
SLACK_WEBHOOK_URL=
